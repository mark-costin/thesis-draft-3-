# Patient portal image (Reflex frontend). Built from the repo root by docker-compose.yml.
# The browser's address of Reflex's backend is built into the pages, so it is a build argument:
#   local:  http://localhost:8001 (default)
#   server: https://<your domain>  (PUBLIC_URL in .env; Nginx forwards /_event and /_upload to port 8001)
FROM python:3.11-slim-bookworm

# curl + unzip: Reflex downloads Bun and Node to build the pages (needs internet while building)
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

RUN useradd --create-home --uid 10001 app
COPY --chown=app:app frontend ./frontend
USER app
WORKDIR /app/frontend

ARG PUBLIC_URL=http://localhost:8001
ENV REFLEX_API_URL=${PUBLIC_URL} \
    REFLEX_ENV_MODE=prod
# Build the pages once here, so the container starts fast and needs no internet at run time
RUN reflex export --frontend-only --no-zip

EXPOSE 3000 8001
CMD ["reflex", "run", "--env", "prod", "--backend-host", "0.0.0.0"]
