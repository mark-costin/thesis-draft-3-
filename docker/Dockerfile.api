# API and OCR worker image (FastAPI + RQ). The same image runs both; docker-compose.yml picks the command.
# Build from the repo root:  docker compose build
FROM python:3.11-slim-bookworm

# libpango/libharfbuzz/fonts: WeasyPrint (PDF reports). libgomp1: XGBoost.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libharfbuzz-subset0 fonts-dejavu-core libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# uv, pinned, copied from its official image
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

# Dependencies first (cached until pyproject.toml or uv.lock change). Only the app's
# dependencies: no dev (pytest) and no ml (Jupyter, MLflow) group.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend ./backend
COPY ml/__init__.py ml/features.yaml ./ml/

# Run as a normal user, never root. The uploads and model folders are volumes in
# docker-compose.yml; creating them here gives the volumes this user as owner.
RUN useradd --create-home --uid 10001 app \
 && mkdir -p /app/backend/uploads /app/ml/artifacts \
 && chown -R app:app /app/backend/uploads
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
