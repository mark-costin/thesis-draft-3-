DATABASE_URL=postgresql+psycopg://med_app:CHANGE_ME@localhost:5432/med_db
TEST_DATABASE_URL=postgresql+psycopg://med_app:CHANGE_ME@localhost:5432/med_db_test
# Generate your own:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
# Optional. Leave REDIS_ENABLED=false unless Redis is running (rate limits and idempotency keys
# then live in memory). CORS_ORIGINS is the frontend address, as a JSON list.
REDIS_ENABLED=false
CORS_ORIGINS=["http://localhost:3000"]
# Encrypts uploaded lab documents. Generate your own and keep a copy (losing it = files unreadable):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# OCR engine for lab documents (docs/ocr.md). Whatever it reads, the patient reviews and confirms.
#   none          no OCR: patients type the values in
#   pdf_text      reads PDFs that already contain text (lab portal PDFs); no GPU, nothing to install
#   paddleocr_vl  PaddleOCR-VL for photos and scanned PDFs; needs an NVIDIA GPU and the separate
#                 install step in docs/ocr.md (not part of uv sync)
OCR_ENGINE=none
# Only for paddleocr_vl: gpu:0, or cpu (very slow)
OCR_DEVICE=gpu:0

# Risk models: keep false until the 4 models are registered in model_versions (Sprint 5).
RISK_MODELS_ENABLED=false

# Show care plan drafts before the physician approves them (demos only; false for real patients).
SHOW_DRAFT_CARE_PLANS=false

# Development only: print password reset links in the API console (no mail server yet).
# Must be false on a server, where the console is the log.
PRINT_RESET_LINKS=true
# true logs full tracebacks for unhandled errors (debugging only; they can hold health data).
LOG_ERROR_DETAILS=false

# ---------------------------------------------------------------------------
# Docker only (docker-compose.yml and docker-compose.dev.yml). Not needed when you run
# PostgreSQL yourself. Use long random values, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD: the postgres superuser inside the container (for DBeaver and admin work).
# APP_DB_PASSWORD: the med_app login the API uses (00_roles.sh creates med_app with it).
# REDIS_PASSWORD: Redis refuses clients without it.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_postgres
APP_DB_PASSWORD=CHANGE_ME_med_app
REDIS_PASSWORD=CHANGE_ME_redis
# Optional, Docker only: the OCR engine in the containers (pdf_text by default; the image has no
# PaddleOCR). Set to none to switch OCR off in Docker. OCR_ENGINE above stays for running with uv.
# DOCKER_OCR_ENGINE=none
