DATABASE_URL=postgresql+psycopg://med_app:CHANGE_ME@localhost:5432/med_db
TEST_DATABASE_URL=postgresql+psycopg://med_app:CHANGE_ME@localhost:5432/med_db_test
# Generate your own:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
# Optional. Leave REDIS_ENABLED=false unless Redis is running (rate limits and idempotency keys
# then live in memory). CORS_ORIGINS is the frontend address, as a JSON list.
REDIS_ENABLED=false
CORS_ORIGINS=["http://localhost:3000"]
# Encrypts uploaded lab documents. Generate your own and keep a copy (losing it = files unreadable):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# OCR engine for lab documents: none (no OCR yet; patients type values in). See backend/ocr.py.
OCR_ENGINE=none

# Risk models: keep false until the 4 models are registered in model_versions (Sprint 5).
RISK_MODELS_ENABLED=false

# Show care plan drafts before the physician approves them (demos only; false for real patients).
SHOW_DRAFT_CARE_PLANS=false

# Development only: print password reset links in the API console (no mail server yet).
# Must be false on a server, where the console is the log.
PRINT_RESET_LINKS=true
# true logs full tracebacks for unhandled errors (debugging only; they can hold health data).
LOG_ERROR_DETAILS=false
